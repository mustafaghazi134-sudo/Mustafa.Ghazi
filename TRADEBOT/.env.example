# Copy to .env. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# ---------- LIVE TRADING ONLY (leave unset for paper trading) ----------
# Private key of a DEDICATED Phantom account funded only with risk capital.
# Phantom -> Settings -> Manage Accounts -> (account) -> Show Private Key  (base58 string)
# SOLANA_PRIVATE_KEY=
# Independent gate #2: live orders are sent only when this is exactly I_ACCEPT_THE_RISK
# TRADEBOT_LIVE_TRADING=I_ACCEPT_THE_RISK
# Optional: paid Jupiter API key (higher rate limits)
# JUPITER_API_KEY=

# Emergency stop from the environment (equivalent to `tradebot kill`)
# TRADEBOT_KILL=1
